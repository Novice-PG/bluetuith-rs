#!/usr/bin/make -f
# Native builds only. For cross-architecture .deb packages use
# packaging/build-debs.sh (or .github/workflows/debs.yml).

%:
	dh $@

override_dh_auto_build:
	cargo build --release --bin bluetuith-rs

override_dh_auto_test:
	cargo test --release

override_dh_auto_install:
	install -D -m755 target/release/bluetuith-rs \
		debian/bluetuith-rs/usr/bin/bluetuith-rs
	install -D -m644 debian/bluetuith-rs.1 \
		debian/bluetuith-rs/usr/share/man/man1/bluetuith-rs.1
	install -D -m644 debian/bluetuith-rs.desktop \
		debian/bluetuith-rs/usr/share/applications/bluetuith-rs.desktop
	install -D -m644 debian/bluetuith-rs.bash-completion \
		debian/bluetuith-rs/usr/share/bash-completion/completions/bluetuith-rs
	install -D -m644 debian/bluetuith-rs.zsh-completion \
		debian/bluetuith-rs/usr/share/zsh/vendor-completions/_bluetuith-rs
	install -D -m644 config.example.toml \
		debian/bluetuith-rs/usr/share/doc/bluetuith-rs/examples/config.toml
	install -D -m644 README.md \
		debian/bluetuith-rs/usr/share/doc/bluetuith-rs/README.md
